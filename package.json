{
  "name": "aethra-seven-thrones",
  "version": "1.0.0",
  "private": true,
  "description": "Aethra: Seven Thrones — an Epic Seven-inspired turn-based hero RPG with accounts, campaign, Arena and real-time World Arena.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sim": "tsx scripts/sim.ts",
    "assets": "node scripts/build-assets.mjs",
    "docs:heroes": "tsx scripts/gen-hero-docs.ts"
  },
  "dependencies": {
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@gltf-transform/cli": "^4.5.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
